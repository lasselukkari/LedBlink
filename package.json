{
  "name": "led-blink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firmware": "npm run build && awot-static",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "awot-scripts": "3.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "awot-static": {
    "sources": "./dist",
    "indexFile": "index.html",
    "sketchDir": "./BlinkServer",
    "exclude": [
      "*.map"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
